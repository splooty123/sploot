~code(
    ~var(x)(-2.5)
    ~var(y)(-2.0)
    ~var(width)(200)
    ~var(height)(100)
    ~var(max_iter)(100)
    ~var(x_pos)(0.0)
    ~var(y_pos)(0.0)
    ~var(next_x)(0.0)
    ~var(next_y)(0.0)
    ~var(iter)(0)
    ~size(2)
    ~repeat(@height)(
        ~set(x)(-2.5)
        ~repeat(@width)(
            ~set(x_pos)(0.0)
            ~set(y_pos)(0.0)
            ~set(next_x)(0.0)
            ~set(next_y)(0.0)
            ~set(iter)(0)
            ~while(~expr(@iter < @max_iter && (@x_pos * @x_pos + @y_pos * @y_pos) < 4.0))(
                ~set(next_x)(~expr(@x_pos * @x_pos - @y_pos * @y_pos + @x))
                ~set(next_y)(~expr(2.0 * @x_pos * @y_pos + @y))
                ~set(x_pos)(@next_x)
                ~set(y_pos)(@next_y)
                ~set(iter)(~expr(@iter + 1))
            )
            ~expr(@iter < @max_iter ? _ : #)
            ~set(x)(~expr(@x + 4 / @width))
        )
        ~nl
        ~set(y)(~expr(@y + 4 / @height))
    )
)